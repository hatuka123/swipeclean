    <!-- Onboarding -->
    <string name="onboarding_title">מפנים מקום, החלקה אחרי החלקה</string>
    <string name="onboarding_body">האפליקציה מציגה את התמונות והסרטונים אחד אחרי השני, כך שהניקוי לוקח דקות ולא שעות.</string>
    <string name="gesture_keep">החלקה ימינה – לשמור</string>
    <string name="gesture_delete">החלקה שמאלה – לסמן למחיקה</string>
    <string name="gesture_move">החלקה למעלה – להעביר לתיקייה</string>
    <string name="perm_media_title">גישה לתמונות ולסרטונים</string>
    <string name="perm_media_body">נדרשת כדי להציג את הגלריה. הכול נשאר בטלפון: לאפליקציה אין גישה לאינטרנט, אין פרסומות ואין מעקב.</string>
    <string name="perm_safe_title">שום דבר לא נמחק בלי אישור שלך</string>
    <string name="perm_safe_body">פריטים שהחלקת שמאלה מחכים בסל של האפליקציה. אנדרואיד מבקש אישור לפני כל העברה או מחיקה, ופריטים שנמחקו נשארים בסל המחזור של המערכת כ־30 יום.</string>
    <string name="perm_notify_title">תזכורות יומיות (לא חובה)</string>
    <string name="perm_notify_body">אם תגדיר תוכנית ניקוי יומית, האפליקציה תבקש הרשאה להציג התראת תזכורת.</string>
    <string name="onboarding_allow">לאפשר גישה</string>
    <string name="denied_title">אין גישה לגלריה</string>
    <string name="denied_body">האפליקציה לא יכולה לעבוד בלי גישה לתמונות ולסרטונים. אפשר לאשר זאת בהגדרות האפליקציה, תחת "הרשאות".</string>
    <string name="denied_open_settings">פתיחת ההגדרות</string>
