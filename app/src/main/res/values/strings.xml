<resources>
    <string name="app_name">SwipeClean</string>

    <!-- Onboarding -->
    <string name="onboarding_title">Free up space, one swipe at a time</string>
    <string name="onboarding_body">SwipeClean shows your photos and videos one by one, so cleaning up takes minutes instead of hours.</string>
    <string name="gesture_keep">Swipe right to keep</string>
    <string name="gesture_delete">Swipe left to mark for deletion</string>
    <string name="gesture_move">Swipe up to move to a folder</string>
    <string name="perm_media_title">Access to photos and videos</string>
    <string name="perm_media_body">Needed to show your gallery. Everything stays on your phone: SwipeClean has no internet access, no ads and no analytics.</string>
    <string name="perm_safe_title">Nothing is deleted without your OK</string>
    <string name="perm_safe_body">Items you swipe left wait in the app\'s bin. Android asks you to confirm before anything is moved or deleted, and deleted items stay in the system trash for about 30 days.</string>
    <string name="perm_notify_title">Daily reminders (optional)</string>
    <string name="perm_notify_body">If you set up a daily cleanup plan, SwipeClean will ask for permission to show a reminder notification.</string>
    <string name="onboarding_allow">Allow access</string>
    <string name="denied_title">No access to your gallery</string>
    <string name="denied_body">SwipeClean can\'t work without access to your photos and videos. You can allow it in the app settings, under Permissions.</string>
    <string name="denied_open_settings">Open settings</string>
    <string name="denied_try_again">Try again</string>

